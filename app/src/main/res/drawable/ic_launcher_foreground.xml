<?xml version="1.0" encoding="utf-8"?>
<!-- Stylised Wi-Fi arcs, one per band colour, drawn inside the 108dp adaptive-icon canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer arc: 2.4 GHz (amber) -->
    <path
        android:pathData="M30,52 A34,34 0 0 1 78,52"
        android:strokeColor="#FFB74D"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <!-- Middle arc: 5 GHz (blue) -->
    <path
        android:pathData="M39,61 A21,21 0 0 1 69,61"
        android:strokeColor="#64B5F6"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <!-- Inner arc: 6 GHz (purple) -->
    <path
        android:pathData="M48,70 A8.5,8.5 0 0 1 60,70"
        android:strokeColor="#CE93D8"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <!-- Dot -->
    <path
        android:pathData="M54,76 m-4,0 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0"
        android:fillColor="#FFFFFF" />
</vector>
